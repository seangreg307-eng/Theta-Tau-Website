
/* ---------- Basic Layout Styles ----------- */

html,
body
{
  height: auto;
}

#page {
margin: 0 auto;
position: relative;
width: 1400px;
height: auto;
}

#page-wrapper {
  height: auto;
  min-height: 100%;
  /*min-width: 980px;*/
  width: 100%;
}
#header div.section,
#featured div.section,
#messages div.section,
#main,
#triptych,
#footer-columns,
#footer {

  margin-right: auto;
}
#header div.section {
  position: relative;
  height: 102px;
}
.region-header {
  float: right; /* LTR */
  margin: 0 5px 10px;
}
.with-secondary-menu .region-header {
  margin-top: 3em;
}
.without-secondary-menu .region-header {
  margin-top: 15px;
}
#secondary-menu {
  position: absolute;
  right: 0; /* LTR */
  top: 0;
  width: 480px;
}
#content,
#sidebar-first,
#sidebar-second,
.region-triptych-first,
.region-triptych-middle,
.region-triptych-last,
.region-footer-firstcolumn,
.region-footer-secondcolumn,
.region-footer-thirdcolumn,
.region-footer-fourthcolumn {
  display: inline;
  float: left; /* LTR */
  position: relative;
}
.one-sidebar #content {
  width: 720px;
}
.two-sidebars #content {
  overflow: hidden;
  width: 580px;
}
.no-sidebars #content {
  width: 960px;
  float: none;
}
#sidebar-first,
#sidebar-second {
  padding-top: 23px;
  width: 240px;
}
#main-wrapper {
	clear: both;
	margin-top: -20px;
  	background-color: white;

}
#content .section,
.sidebar .section {
  padding: 0 15px;
}
#breadcrumb {
  margin: 0 15px;
}
.region-triptych-first
{
	width: 218px;
	overflow: hidden;
}

.region-footer-firstcolumn,
.region-footer-secondcolumn,
.region-footer-thirdcolumn,
.region-footer-fourthcolumn {
  padding: 0 10px;
  width: 220px;
}
#footer {
  min-width: 920px;
}

.region-triptych-first {
	height: auto;
        width: 240px;
  padding-right: 0px;
}

.region-triptych-middle {
	height: auto;
	z-index: 6;
	width: 60%;
  padding-left: 30px;
}

.region-triptych-last {
display: inline;
float: left;
width: 240px;
}
